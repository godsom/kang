# Copy to .env and adjust if needed. Matches docker-compose.yml's default dev services.

DATABASE_URL=postgres://kaeng:kaeng_dev_password@localhost:5432/kaeng
# Separate database for the test suite — several test files TRUNCATE users/
# wallets/transactions between tests, which would wipe real accounts if this
# pointed at the same database as DATABASE_URL above. Create it once with:
#   docker compose exec postgres psql -U kaeng -d kaeng -c "CREATE DATABASE kaeng_test;"
#   DATABASE_URL=postgres://kaeng:kaeng_dev_password@localhost:5432/kaeng_test node scripts/migrate.js
TEST_DATABASE_URL=postgres://kaeng:kaeng_dev_password@localhost:5432/kaeng_test
REDIS_URL=redis://localhost:6379

# LiveKit dev-mode server (docker-compose's `livekit` service, run with --dev)
# --dev always uses this fixed placeholder key/secret pair (see startup log).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Auth/Wallet service (src/auth)
AUTH_PORT=4000
JWT_SECRET=dev_jwt_secret_change_in_production
