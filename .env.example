# Copy to .env and adjust if needed. Matches docker-compose.yml's default dev services.

DATABASE_URL=postgres://kaeng:kaeng_dev_password@localhost:5432/kaeng
REDIS_URL=redis://localhost:6379

# LiveKit dev-mode server (docker-compose's `livekit` service, run with --dev)
# --dev always uses this fixed placeholder key/secret pair (see startup log).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Auth/Wallet service (src/auth)
AUTH_PORT=4000
JWT_SECRET=dev_jwt_secret_change_in_production
